{
  "name": "mm-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mm": "./dist/mm.js"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
    "test": "vitest run",
    "calibrate": "tsx tools/calibrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.tsx --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/mm.js --banner:js='#!/usr/bin/env node'"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}